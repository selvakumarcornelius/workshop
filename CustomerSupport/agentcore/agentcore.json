{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "CustomerSupport",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "CustomerSupport"
  },
  "runtimes": [
    {
      "name": "CustomerSupport",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/CustomerSupport/",
      "runtimeVersion": "PYTHON_3_13",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "requestHeaderAllowlist": [
        "X-Amzn-Bedrock-AgentCore-Runtime-Custom-User-Id",
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-west-2.amazonaws.com/us-west-2_GIqoSgIsc/.well-known/openid-configuration",
          "allowedClients": [
            "2laqga5kk2vm3tlgns0eifpqlq"
          ]
        }
      }
    },
    {
      "name": "CustomerSupportAB",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/CustomerSupportAB/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "SharedMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [
    {
      "authorizerType": "OAuthCredentialProvider",
      "name": "gateway-egress-oauth",
      "discoveryUrl": "https://cognito-idp.us-west-2.amazonaws.com/us-west-2_GIqoSgIsc/.well-known/openid-configuration",
      "scopes": [
        "default-m2m-resource-server-b5d13dc0/read"
      ],
      "vendor": "CustomOauth2"
    }
  ],
  "evaluators": [],
  "onlineEvalConfigs": [
    {
      "name": "QualityMonitor",
      "agent": "CustomerSupport",
      "evaluators": [
        "Builtin.GoalSuccessRate",
        "Builtin.Correctness",
        "Builtin.ToolSelectionAccuracy"
      ],
      "samplingRate": 100,
      "enableOnCreate": true
    },
    {
      "name": "ABQualityMonitor",
      "agent": "CustomerSupportAB",
      "evaluators": [
        "Builtin.GoalSuccessRate"
      ],
      "samplingRate": 100,
      "enableOnCreate": true
    }
  ],
  "agentCoreGateways": [
    {
      "name": "my-gateway-secure",
      "protocolType": "None",
      "description": "Gateway for my-gateway-secure",
      "targets": [
        {
          "name": "WarrantyCheck",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-west-2:299596097211:function:workshop-warranty-check",
            "toolSchemaFile": "app/CustomerSupport/tool/warranty_schema.json"
          }
        },
        {
          "name": "ProcessRefund",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-west-2:299596097211:function:workshop-process-refund",
            "toolSchemaFile": "app/CustomerSupport/tool/refund_schema.json"
          }
        },
        {
          "name": "customer-support-ab",
          "targetType": "httpRuntime",
          "httpRuntime": {
            "runtime": "CustomerSupportAB"
          }
        }
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-west-2.amazonaws.com/us-west-2_GIqoSgIsc/.well-known/openid-configuration",
          "allowedClients": [
            "2laqga5kk2vm3tlgns0eifpqlq",
            "383iiedmu5o16mum4ok6gc8jvb"
          ]
        }
      },
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE",
      "policyEngineConfiguration": {
        "policyEngineName": "CustomerSupportPolicyEngine",
        "mode": "LOG_ONLY"
      }
    }
  ],
  "unassignedTargets": [
    {
      "name": "WarrantyCheck",
      "targetType": "lambdaFunctionArn",
      "lambdaFunctionArn": {
        "lambdaArn": "arn:aws:lambda:us-west-2:299596097211:function:workshop-warranty-check",
        "toolSchemaFile": "app/CustomerSupport/tool/warranty_schema.json"
      }
    }
  ],
  "policyEngines": [
    {
      "name": "CustomerSupportPolicyEngine",
      "description": "Governs customer support agent tool access — refund limits and tool permissions",
      "policies": [
        {
          "name": "refund_limit_policy",
          "description": "Allow refunds under 100 dollars only",
          "statement": "permit(principal, action == AgentCore::Action::\"ProcessRefund___process_refund\", resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:us-west-2:299596097211:gateway/customersupport-my-gateway-secure-j9a4hezdqi\") when { context.input.amount < 100 };",
          "validationMode": "FAIL_ON_ANY_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        },
        {
          "name": "warranty_check_policy",
          "description": "Allow all authenticated users to check warranties",
          "statement": "permit(principal, action == AgentCore::Action::\"WarrantyCheck___check_warranty\", resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:us-west-2:299596097211:gateway/customersupport-my-gateway-secure-j9a4hezdqi\") when { (principal is AgentCore::OAuthUser) };",
          "validationMode": "IGNORE_ALL_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        },
        {
          "name": "refund_reason_policy",
          "statement": "forbid (principal, action == AgentCore::Action::\"ProcessRefund___process_refund\", resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:us-west-2:299596097211:gateway/customersupport-my-gateway-secure-j9a4hezdqi\")\nunless { context.input.reason like \"*defective*\" };",
          "validationMode": "FAIL_ON_ANY_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        }
      ]
    }
  ],
  "configBundles": [
    {
      "name": "customerSupportControl",
      "type": "ConfigurationBundle",
      "components": {
        "{{runtime:CustomerSupportAB}}": {
          "configuration": {
            "system_prompt": "You are a helpful and professional customer support assistant for an e-commerce company. Provide accurate information using the tools available to you. Be friendly, patient, and understanding. Always offer additional help after answering. Always use tools to get accurate information rather than guessing."
          }
        }
      },
      "branchName": "mainline",
      "commitMessage": "Baseline prompt"
    },
    {
      "name": "customerSupportTreatment",
      "type": "ConfigurationBundle",
      "components": {
        "{{runtime:CustomerSupportAB}}": {
          "configuration": {
            "system_prompt": "You are a helpful and professional customer support assistant for an e-commerce company. Be friendly, patient, and understanding. Always use tools to get accurate information rather than guessing. When a <user_context> block is provided, use it to personalize your response (e.g., greet by name, reference past interactions). Present tool results in clear, structured bullet points. When a tool call fails or is denied, explain the reason to the user and suggest alternatives. When multiple lookups are needed, call tools in parallel. Before taking any action with real-world consequences such as processing a refund, state the planned action and wait for explicit user approval. Do not treat silence or ambiguity as consent. Always offer additional help after answering."
          }
        }
      },
      "branchName": "mainline",
      "commitMessage": "Recommended prompt from cs-prompt-rec"
    }
  ],
  "abTests": [],
  "harnesses": [
    {
      "name": "OrderResearchAgent",
      "path": "app/OrderResearchAgent"
    },
    {
      "name": "PersistentReportAgent",
      "path": "app/PersistentReportAgent"
    },
    {
      "name": "ContainerAgent",
      "path": "app/ContainerAgent"
    }
  ],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
